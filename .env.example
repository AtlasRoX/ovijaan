# ===== Firebase Configuration =====
# Get these from Firebase Console -> Project Settings -> General -> Web app.
#
# The Web API key is safe to expose in client bundles — it identifies your
# project, it does NOT authenticate anyone. Firebase explicitly supports this.

# Server-side (used by Next.js API routes for Firebase REST calls)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Client-side (NEXT_PUBLIC_ prefix exposes to the browser bundle)
# Used only for Google Sign-In popup. Same API key and auth domain as above.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# ===== Session Signing Secret =====
# Generate with:  openssl rand -hex 32
# This signs the HMAC-SHA256 session cookie. NEVER commit the real value.
SESSION_SECRET=generate_a_random_64_char_hex_string_here
